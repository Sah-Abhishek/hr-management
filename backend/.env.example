# Example Environment Configuration
# Copy this file to .env and update with your values

# Backend Server Configuration
PORT=9001
HOST=0.0.0.0

# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?appName=appname
DB_NAME=hrms_production

# Security
JWT_SECRET_KEY=your-super-secure-jwt-secret-key
CORS_ORIGINS=http://your-server-ip:9000

# Application URLs
FRONTEND_URL=http://your-server-ip:9000
BACKEND_URL=http://your-server-ip:9001

# Email Configuration (Optional)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your-email-api-key

# Environment
ENVIRONMENT=production
